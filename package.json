{
  "name": "cortico-provider-opencode",
  "version": "0.3.6",
  "type": "module",
  "description": "OpenCode 的模型供应商:默认走 Go 订阅的额度,支持 Responses、Chat、Messages 与 Gemini,内置价目与额度面板。",
  "license": "MIT",
  "author": "云纪",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Unnori/cortico-provider-opencode.git"
  },
  "homepage": "https://github.com/Unnori/cortico-provider-opencode#readme",
  "bugs": {
    "url": "https://github.com/Unnori/cortico-provider-opencode/issues"
  },
  "keywords": [
    "cortico-provider",
    "cortico",
    "opencode",
    "llm",
    "gateway"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "provider",
    "api": 6,
    "icon": "icon.png",
    "tags": [],
    "describe": "describe.json",
    "webUiClient": "dist/webui.js"
  },
  "files": [
    "src",
    "dist",
    "icon.png",
    "describe.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build:webui": "esbuild src/webui/client.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=dist/webui.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.2.8",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
